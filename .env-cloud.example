# Copy to .env on the Oracle VM and fill in. CLOUD_MODE=true flips every cloud default.
CLOUD_MODE=true

# --- Core (required) ---
APP_ID=
APP_SECRET=
# host "db" = the compose mariadb service
DATABASE_URL=mysql://n0th1ng:DBPASSWORD@db:3306/n0th1ng
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
PRODUCTION_ORIGIN=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example

# --- Passkeys ---
WEBAUTHN_RP_ID=your-domain.example
WEBAUTHN_ORIGIN=https://your-domain.example

# --- Cloudflare Access (recommended) ---
CF_ACCESS_REQUIRED=true
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- LLM routing ---
# Worker Ollama reachable over tunnel/VPN (leave blank until the GPU worker is connected)
OLLAMA_BASE_URL=
# Embeddings: small ollama-embed container (docker compose --profile embeddings up -d; then pull nomic-embed-text)
OLLAMA_EMBED_URL=http://ollama-embed:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENROUTER_API_KEY=
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=google/gemma-4-31b-it:free

# --- Feature flags (cloud defaults shown) ---
ENABLE_LOCAL_RUNTIMES=false
ENABLE_COMPANION=false
ENABLE_FORGE=false

# --- GPU worker (later) ---
WORKER_DESKTOP_URL=
WORKER_DESKTOP_KEY=

# --- docker-compose only ---
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=n0th1ng
MARIADB_USER=n0th1ng
MARIADB_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
