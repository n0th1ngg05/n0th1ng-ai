# ── Worker Deployment Environment ──────────────────────────────────────────

# Base storage partition for all models and Docker engine
STORAGE_PATH=/data

# Worker API Authentication (Generate with: openssl rand -hex 32)
WORKER_API_KEY=replace_with_worker_api_key_32_chars

# Local HUD Authentication Token (Generate with: openssl rand -hex 16)
HUD_TOKEN=replace_with_hud_token_16_chars

# MySQL Database URL
WORKER_DATABASE_URL=mysql://root:password@127.0.0.1:3306/workerdb

# Primary Chatbot Resident Model (on AMD RX 9060 XT)
PRIMARY_LLM_MODEL=nemotron-3.5-bolt:e4b

# ROCm architecture override (leave blank unless your specific AMD card needs gfx target override)
# e.g., HSA_OVERRIDE_GFX_VERSION=11.0.0 or 10.3.0
HSA_OVERRIDE_GFX_VERSION=

# Internet Exposure mode: quick (default free ephemeral tunnel) or named
CF_TUNNEL_MODE=quick
