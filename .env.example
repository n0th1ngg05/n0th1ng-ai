# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# Set CLOUD_MODE=true (see .env-cloud.example) to enable cloud defaults.
CLOUD_MODE=false
# Forge/ForgeX are disabled by default. Set true to enable.
ENABLE_FORGE=false
