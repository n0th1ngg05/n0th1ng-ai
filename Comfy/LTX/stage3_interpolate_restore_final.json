      "torch_compile": false,
      "batch_size": 1,
      "frames": [
        "110",
        0
      ]
    },
    "class_type": "RIFE VFI",
    "_meta": {
      "title": "RIFE VFI (2x frame interpolation, 24fps -> 48fps for smooth motion)"
